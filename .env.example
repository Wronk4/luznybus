# Klucz Google Maps JavaScript API (+ opcjonalnie Places API (New) do wyszukiwania adresów).
# Bez klucza aplikacja działa na mapie OpenStreetMap (Leaflet) – przydatne do developmentu.
GOOGLE_MAPS_API_KEY=
# Map ID z Google Cloud Console (wymagane dla AdvancedMarker). DEMO_MAP_ID działa do testów.
GOOGLE_MAP_ID=DEMO_MAP_ID

PORT=3000

# Zegar symulacji: domyślnie czas rzeczywisty (Europe/Warsaw); poza godzinami kursowania startuje o 07:45.
# SIM_TIME=07:45
# SIM_SPEED=1

# --- PRAWDZIWE DANE (Rzeszów) -------------------------------------------------
# Rozkład GTFS (pobierany raz na dobę) + pozycje pojazdów na żywo (GTFS-Realtime).
# Źródło: https://kmrzeszow.live/otwartedane/ (serwis społecznościowy, niepowiązany z ZTM/MPK;
# oficjalny rozkład ZTM: https://otwartedane.erzeszow.pl/dataset/rozklady-jazdy-gtfs)
# GTFS_URL=https://kmrzeszow.live/gtfs/latest.zip
# GTFS_RT_URL=https://kmrzeszow.live/gtfs/rt/gtfsrt.pb
# GTFS_RT_INTERVAL=15
# CITY_NAME=Rzeszów

# Alternatywnie: lokalny, rozpakowany katalog GTFS (bez danych na żywo = symulacja na prawdziwym rozkładzie)
# GTFS_DIR=./data/gtfs
